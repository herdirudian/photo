# Theme Park Offline Face Recognition Photo Retrieval System
# Environment Configuration

# Directories (Inside container or local environment)
RAW_DIR=/app/data/raw
RESULTS_DIR=/app/data/results
DB_DIR=/app/data/db

# Similarity search threshold (0.50 - 0.95, default 0.75)
DEFAULT_SIMILARITY_THRESHOLD=0.75

# Face detection model: 'hog' (fast CPU) or 'cnn' (high-accuracy GPU)
FACE_DETECTION_MODEL=hog

# Network Samba Share path displayed to operators for quick copy-paste
SAMBA_NETWORK_PREFIX=\\samba-server\park-photos\results
